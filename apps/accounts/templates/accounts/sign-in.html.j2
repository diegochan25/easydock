{% extends layout('accounts.html.j2') %}

{% block content %}
<form method="post" class="w-full max-w-lg bg-surface-100 border border-border rounded-lg p-6 flex flex-col gap-6">
    {{ csrf_input }}
    <div class="space-y-2">
        <h2 class="text-2xl font-semibold">Sign in</h2>
        <p class="text-ink-muted">
            Use your account on this instance
        </p>
    </div>
    <div class="space-y-1">
        <div class="block font-medium">
            {{ form.email.label_tag() }}
        </div>
        <div class="bg-surface-0 border border-border rounded-md text-lg w-full flex items-center px-2 py-1 gap-2 outline-2 outline-transparent has-focus:outline-focus-ring duration-150">
            {{ form.email }}
        </div>
        <div class="text-sm {% if form.email.errors %}text-red-600{% else %}text-ink-muted{% endif %}">
            {% if form.email.errors %}
                {{ form.email.errors }}
            {% else %}
            {% endif %}
        </div>
    </div>
    <div class="space-y-1" x-data="{showPassword: false}">
        <div class="flex items-center gap-2">
            <div class="flex-1 font-medium">
                {{ form.password.label_tag() }}
            </div>
            <a href="{{ url('accounts:forgot_password') }}" class="text-brand-strong hover:underline">Forgot password?</a>
        </div>
        <div class="bg-surface-0 border border-border rounded-md text-lg w-full flex items-center px-2 py-1 gap-2 outline-2 outline-transparent has-focus:outline-focus-ring duration-150">
            {{ form.password }}
            <button 
                type="button"
                class="text-brand text-sm font-medium hover:underline" 
                x-on:click="showPassword = !showPassword"
                x-text="showPassword ? 'Hide' : 'Show'"
            ></button>
        </div>
        <div class="text-sm {% if form.password.errors %}text-red-600{% else %}text-ink-muted{% endif %}">
            {% if form.password.errors %}
                {{ form.password.errors }}
            {% else %}
            {% endif %}
        </div>
    </div>
    <div class="space-y-1">
        <div class="flex items-center gap-2">
            {{ form.remember_me }}
            {{ form.remember_me.label_tag() }}
        </div>
        <div class="text-sm {% if form.remember_me.errors %}text-red-600{% else %}text-ink-muted{% endif %}">
            {% if form.remember_me.errors %}
                {{ form.remember_me.errors }}
            {% else %}
            {% endif %}
        </div>
    </div>
    <input 
        type="submit" 
        value="Sign in" 
        class="px-3 py-2 rounded-lg bg-brand text-surface-0 font-medium hover:bg-brand/70 active:translate-y-0.5 duration-150"
    >
    <hr class="border-t border-border">
    <p class="w-full text-center text-ink-muted">
        Accounts on this instance are created by 
        invitation. Ask an owner to send you one.
    </p>
</form>
{% endblock %}