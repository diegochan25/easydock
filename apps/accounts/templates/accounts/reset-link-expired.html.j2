{% extends layout('accounts.html.j2') %}

{% block content %}
<div class="w-full max-w-lg bg-surface-100 border border-border rounded-lg p-6 flex flex-col gap-6">
    <div class="p-4 rounded-full bg-warning-soft flex justify-center items-center overflow-hidden">
        <i data-lucide="clock" class="size-6 text-warning"></i>
    </div>
    <div class="space-y-2">
        <h2 class="text-2xl font-semibold">This reset link has expired</h2>
        <p class="text-ink-muted">
            Reset links work once and expire after 
            30 minutes. Request a new one to continue.
        </p>
    </div>
    <div class="flex flex-col w-full gap-4">
        <a 
            href=""
            class="flex justify-center items-center px-3 py-2 rounded-lg bg-brand text-surface-0 font-medium hover:bg-brand/70 active:translate-y-0.5 duration-150"
        >Request a new link</a>
        <a 
            href="{{ url('accounts:sign_in') }}"
            class="flex justify-center items-center px-3 py-2 rounded-lg text-brand bg-border font-medium hover:bg-border/70 active:translate-y-0.5 duration-150"
        >Back to sign in</a>
    </div>
</div>
{% endblock %}