{% extends layout('accounts.html.j2') %}

{% block content %}
<form method="post" class="w-full max-w-lg bg-surface-100 border border-border rounded-lg p-6 flex flex-col gap-6">
    {{ csrf_input }}
    <div class="space-y-2">
        <h2 class="text-2xl font-semibold">Reset your password</h2>
        <p class="text-ink-muted">
            Enter the email for your account and we'll 
            send you a link to choose a new password.
        </p>
    </div>
    <div class="space-y-1">
        <div class="block font-medium">
            {{ form.email.label_tag() }}
        </div>
        <div class="bg-surface-0 border border-border rounded-md text-lg w-full flex items-center px-2 py-1 gap-2 outline-2 outline-transparent has-focus:outline-focus-ring duration-150">
            {{ form.email }}
        </div>
        <div class="text-sm {% if form.email.errors %}text-red-600{% else %}text-ink-muted{% endif %}">
            {% if form.email.errors %}
                {{ form.email.errors }}
            {% else %}
            {% endif %}
        </div>
    </div>
    <div class="flex flex-col w-full gap-4">
        <input 
            type="submit" 
            value="Send reset link" 
            class="flex justify-center items-center px-3 py-2 rounded-lg bg-brand text-surface-0 font-medium hover:bg-brand/70 active:translate-y-0.5 duration-150"
        >
        <a 
            href="{{ url('accounts:sign_in') }}"
            class="flex justify-center items-center px-3 py-2 rounded-lg text-brand bg-border font-medium hover:bg-border/70 active:translate-y-0.5 duration-150"
        >Back to sign in</a>
    </div>
</form>
{% endblock %}