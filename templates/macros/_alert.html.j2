{% macro alert(message) %}
    {% set props = {
        'debug': { 'bg': 'bg-surface-200', 'text': 'text-ink-muted', 'data_lucide': 'bug' },
        'info': { 'bg': 'bg-info-soft', 'text': 'text-info', 'data_lucide': 'info' },
        'success': { 'bg': 'bg-success-soft', 'text': 'text-success', 'data_lucide': 'check' },
        'warning': { 'bg': 'bg-warning-soft', 'text': 'text-warning', 'data_lucide': 'triangle-alert' },
        'error': { 'bg': 'bg-danger-soft', 'text': 'text-danger', 'data_lucide': 'circle-minus' }
    } %}
    {% set style = props.get(message.level_tag, props['info']) %}

    <div
        class="fixed top-4 right-4 z-10 flex items-center px-3 py-2 rounded-lg text-lg gap-4 w-max min-w-md max-w-2xl {{ style.bg }} {{ style.text }}"
        x-data="{ show: true }"
        x-init="setTimeout(() => show = false, 5000)"
        x-show="show"
        x-transition:enter="duration-300"
        x-transition:enter-start="opacity-0 translate-x-4"
        x-transition:enter-end="opacity-100 translate-x-0"
        x-transition:leave="duration-300"
        x-transition:leave-start="opacity-100 translate-x-0"
        x-transition:leave-end="opacity-0 translate-x-4"
    >
        <i data-lucide="{{ style.data_lucide }}" class="size-5"></i>
        <p class="flex-1">{{ message }}</p>
        <button type="button" class="contents" @click="show = false">
            <i data-lucide="x" class="size-5"></i>
        </button>
    </div>
{% endmacro %}
