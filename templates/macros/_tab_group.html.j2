{% macro tab_group(name, tabs, default=None, class_name='') %}
<div {% if class_name %}class="flex flex-col gap-6 {{ class_name }}"{% endif %} x-data="{ active: '{{ default or tabs[0].id }}' }">
    <div class="flex w-max rounded-lg px-2 py-1 border border-border bg-surface-100">
        {% for t in tabs %}
        <label
            for="{{ name }}-{{ t.id }}"
            class="cursor-pointer rounded-md px-3 py-1 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand-strong"
            x-bind:class="active === '{{ t.id }}' ? 'bg-surface-200 font-medium text-ink' : 'text-muted'"
        >
            <input
                type="radio"
                id="{{ name }}-{{ t.id }}"
                name="{{ name }}"
                value="{{ t.id }}"
                class="sr-only"
                x-model="active"
            >
            <div class="flex items-center gap-2">
                <span>{{ t.label }}</span>
                {% if t.badge is defined and t.badge is not none %}
                <span class="px-2 rounded-full text-sm bg-brand-soft text-brand-strong">
                    {{ t.badge if t.badge <= 99 else "99+" }}
                </span>
                {% endif %}
            </div>
        </label>
        {% endfor %}
    </div>

    <div class="w-full flex-1">
        {{ caller() }}
    </div>
</div>
{% endmacro %}
