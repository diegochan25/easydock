{% macro dialog(id, modal=False) %}
    <div
        class="fixed inset-0 z-50 flex justify-center items-center backdrop-brightness-60 backdrop-blur-xs"
        x-show="activeDialog === '{{ id }}'"
        {% if not modal %}
        x-on:click="activeDialog = null"
        {% endif %}
        x-transition:enter="duration-300"
        x-transition:enter-start="opacity-0 -translate-y-4"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="duration-300"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-4"
    >
        <div 
            class="relative w-full max-w-xl rounded-lg bg-surface-200 border border-border shadow-sm shadow-shadow p-6 h-max max-h-[60vh] overflow-hidden flex flex-col"
            x-show="activeDialog === '{{ id }}'"
            {% if not modal %}
            x-on:click.stop
            {% endif %}
            x-transition:enter="duration-300"
            x-transition:enter-start="opacity-0 -translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="duration-300"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-4"
        >
            {% if not modal %}
                <button
                    class="absolute top-3 right-3 p-0.5 rounded-full overflow-hidden flex justify-center items-center hover:bg-ink-faint duration-150"
                    x-on:click="activeDialog = null"
                >
                    <i data-lucide="x" class="size-5 text-ink"></i>
                </button>
            {% endif %}
            {{ caller() }}
        </div>
    </div>
{% endmacro %}